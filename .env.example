# Site URL — used by metadata, sitemap, robots, and absolute OG image paths.
# In production, set this to your final Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=https://portfolio-jainish.vercel.app

# Required for the /contact form to actually send email.
# Sign up at https://resend.com (free, 3000 emails/month) and create an API key.
RESEND_API_KEY=

# Where contact-form submissions get delivered (defaults to jainish5658@gmail.com).
CONTACT_TO_EMAIL=jainish5658@gmail.com

# "From" identity used by Resend.
# - For testing without a verified domain, leave as: Portfolio <onboarding@resend.dev>
# - For production: verify your domain in Resend, then use e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM=Portfolio <onboarding@resend.dev>
